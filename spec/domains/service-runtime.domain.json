    },
    {
      "pathPattern": "(^|/)src/shared/[^/]+\\.ts$"
    },
    {
      "pathPattern": "(^|/)scripts/build\\.mjs$"
    },
    {
      "pathPattern": "(^|/)web/src/main\\.ts$"
    },
    {
      "pathPattern": "(^|/)web/src/sanitize\\.ts$"
    },
    {
      "pathPattern": "(^|/)web/src/account-view\\.ts$"
    },
    {
      "pathPattern": "(^|/)web/index\\.html$"
    },
    {
      "pathPattern": "(^|/)web/style\\.css$"
    },
    {
      "pathPattern": "(^|/)\\.gitignore$"
    }
  ],
  "specRefs": [
