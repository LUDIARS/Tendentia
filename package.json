{
  "name": "@ludiars/tendentia",
  "version": "0.1.0",
  "private": true,
  "description": "Tendentia (Td): いろいろなジャンルのトレンドを定期巡回して集め、興味の度合いで大きさが変わるマップで見せる。",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.mjs\""
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^4.5.7",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
